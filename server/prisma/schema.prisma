datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// -------------------------------------------------------------
// Users Model
// -------------------------------------------------------------
model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  name       String
  loginToken String?   @unique @map("login_token")
  tokenExpiry DateTime? @map("token_expiry")

  // Relations
  locations             Location[]             // Personal locations owned by this user
  items                 Item[]                 // Catalog items created by this user
  locationSubscriptions LocationSubscription[] // Subscriptions
  notifications         Notification[]
  settings              UserSettings?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model UserSettings {
  id Int @id @default(autoincrement())

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  defaultNotifyExpiring Boolean @default(true) @map("default_notify_expiring")
  defaultNotifyLowStock Boolean @default(true) @map("default_notify_low_stock")

  autoSubscribeNewLocations Boolean @default(true) @map("auto_subscribe_new_locations")
  expiringThresholdDays     Int     @default(7) @map("expiring_threshold_days")

  emailNotifications Boolean @default(true) @map("email_notifications")
  pushNotifications  Boolean @default(false) @map("push_notifications")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

// -------------------------------------------------------------
// Unified Location Hierarchy
// -------------------------------------------------------------
model Location {
  id    Int    @id @default(autoincrement())
  label String

  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  parentId Int?       @map("parent_id")
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationHierarchy")

  // Relations
  stocks        ItemStock[]            // Physical stock stored at this location
  subscriptions LocationSubscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("locations")
}

// -------------------------------------------------------------
// Location Subscriptions
// -------------------------------------------------------------
model LocationSubscription {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  locationId Int      @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  notifyExpiring Boolean @default(true) @map("notify_expiring")
  notifyLowStock Boolean @default(true) @map("notify_low_stock")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, locationId])
  @@map("location_subscriptions")
}

// -------------------------------------------------------------
// Catalog Item Model (The Product Definition)
// -------------------------------------------------------------
model Item {
  id      Int     @id @default(autoincrement())
  label   String
  barcode String? // Unique barcode (EAN/UPC/Custom)

  // Global low stock threshold (evaluated across sum of all stocks)
  lowStockThreshold Int? @map("low_stock_threshold")

  // Default shelf-life rule: "Once opened, use within X days"
  useWithinDays Int? @map("use_within_days")

  // Creator / Owner: null = Shared Household Item, non-null = Personal
  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Soft Delete Catalog Entry
  deletedAt DateTime? @map("deleted_at")

  // Relations
  stocks ItemStock[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([barcode])
  @@index([deletedAt])
  @@index([userId])
  @@map("items")
}

// -------------------------------------------------------------
// Physical Stock Batch Model (Quantity per Location)
// -------------------------------------------------------------
model ItemStock {
  id Int @id @default(autoincrement())

  // Link to Master Catalog Item
  itemId Int  @map("item_id")
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // Physical Location
  locationId Int?      @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  quantity Int @default(1)

  // Per-batch expiration & open tracking
  expirationDate DateTime? @map("expiration_date")
  openedOn       DateTime? @map("opened_on")

  // Soft Delete / Consumed / Archived Batch
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Performance Indexes
  @@index([itemId])
  @@index([locationId])
  @@index([expirationDate])
  @@index([deletedAt])
  @@map("item_stocks")
}

// -------------------------------------------------------------
// Notifications
// -------------------------------------------------------------
model Notification {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title      String
  message    String
  isRead     Boolean  @default(false) @map("is_read")
  
  itemId     Int?     @map("item_id")
  locationId Int?     @map("location_id")
  
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}