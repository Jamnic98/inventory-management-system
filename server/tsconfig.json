{
  "compilerOptions": {
    "paths": {
      "controllers": ["./src/controllers"],
      "models": ["./src/models"],
      "routes": ["./src/routes"],
    },
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*"]
}
